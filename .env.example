# Accounts & leaderboard storage (Upstash Redis REST API).
# On Vercel: Storage → create/connect an Upstash Redis database; these are set automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: use the in-memory store in a production build (data is lost on restart; demos only).
# ACCOUNTS_MEMORY_STORE=1
